# CML / Impala legacy connection (Trino: use your Trino data connection name)
LAGEBILD_CONNECTION_NAME=cdw-aw-se-impala

# Optional full SQL override (default: Baltic-wide union via defense.lagebild)
# LAGEBILD_SQL=SELECT * FROM iceberg.defense.lagebild WHERE harbour_name = 'Kiel'
# Restore German-harbour-only filter: LAGEBILD_GERMAN_ONLY=1

# Trino catalog prefix; set empty or "none" for Impala-style defense.table
LAGEBILD_TRINO_CATALOG=iceberg

# LLM — Cloudera model serving (Mistral) or Azure OpenAI (paste deployment base or full chat URL)
LAGEBILD_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
LAGEBILD_AZURE_API_VERSION=2025-01-01-preview
LAGEBILD_MODEL_ID=gpt-4.1
LAGEBILD_API_KEY=
LAGEBILD_JWT_PATH=/tmp/jwt

LAGEBILD_MAX_CHAR_LIMIT=32000
LAGEBILD_USE_SAMPLE=0
LAGEBILD_INSERT_SQL=0
LAGEBILD_SAMPLE_CSV=

# Direct CDW Trino (alternative to CML data connection)
# LAGEBILD_TRINO_HOST=triton-cdw-trino.example.cloudera.site
# LAGEBILD_TRINO_PORT=443
# LAGEBILD_TRINO_USER=
# LAGEBILD_TRINO_PASSWORD=
# LAGEBILD_TRINO_HTTP_SCHEME=https
# LAGEBILD_TRINO_SCHEMA=defense
# LAGEBILD_SUMMARY_TABLE=situation_awareness_summary
