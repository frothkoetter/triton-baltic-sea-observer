# Cloudera Impala (defense schema)
IMPALA_HOST=coordinator-cdw-aw-se-impala.dw-se-sandbox-aws.a465-9q4k.cloudera.site
IMPALA_PORT=443
IMPALA_DATABASE=defense
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=true
IMPALA_HTTP_PATH=cliservice
# LDAP | PLAIN | NOSASL — AuthMech=12 in JDBC often needs LDAP + corporate credentials
IMPALA_AUTH_MECH=LDAP

# Force sample data even when Impala is reachable
TRITON_FORCE_SAMPLE_DATA=false

# API server (Vite dev proxies /api here)
API_PORT=3001
