# Force sample data even when Impala is reachable
TRITON_FORCE_SAMPLE_DATA=false

# API server (Vite dev proxies /api here)
API_PORT=3001

# Schiffsnähe — SSB MVE real_time_proximity_alert (proxied by GET /api/proximity-alerts)
PROXIMITY_ALERT_API_KEY=a4acf667-33f0-4552-83a8-21f57a7e5eed
