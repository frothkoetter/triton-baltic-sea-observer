# Copy to triton-project.env.local (gitignored) and set secrets there.
# Apply with: scripts/cml/set_project_environment.py --env-file scripts/cml/triton-project.env.local
# Requires: CML_API_KEY, CML_HOST (or --cml-host)

CDSW_APP_POLLING_ENDPOINT=/healthz
PROJECT_OWNER=frothkoetter
CDSW_WORKING_DIRECTORY=/home/cdsw

# Coordinator = triton-trino.* (Copy Trino URL) — NOT the DW overview host cdw-triton.*
TRINO_JDBC_URL=jdbc:trino://triton-trino.dw-triton-cdp-env.a465-9q4k.cloudera.site:443/iceberg/defense
TRINO_USER=your-trino-user
TRINO_PASSWORD=CHANGEME
TRINO_CATALOG=iceberg
TRINO_SCHEMA=defense

# CAI Trino batch jobs (cai-workbench/trino-jobs/cml_job.py) — set on each Scheduled Job if you use multiple:
# TRINO_JOB=outliers          # default: vessel_outliers + baltic_threat_tile_sketches
# TRINO_JOB=socmint_sketch    # after outliers: SOCMINT trust MERGE
# TRINO_JOB=lagebild_views    # refresh lagebild views (weekly / after DDL)
# Optional DDL runner: TRINO_SCHEMA_PREFLIGHT=auto TRINO_SKIP_CREATE_SCHEMA=1

NBA_PERSIST_TRINO=1
NBA_PHASE=7
NBA_SIM_TICKS=6
NBA_MATERIALIZE=1
NBA_SHACL_GATE=1
NBA_EXIT_IF_QUIET=0

LAGEBILD_DATA_ENGINE=trino
LAGEBILD_TRINO_HOST=triton-trino.dw-triton-cdp-env.a465-9q4k.cloudera.site
LAGEBILD_TRINO_PORT=443
LAGEBILD_TRINO_USER=your-trino-user
LAGEBILD_TRINO_PASSWORD=CHANGEME
LAGEBILD_TRINO_HTTP_SCHEME=https
LAGEBILD_TRINO_CATALOG=iceberg
LAGEBILD_TRINO_SCHEMA=defense
LAGEBILD_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2025-01-01-preview
LAGEBILD_MODEL_ID=your-deployment
LAGEBILD_API_KEY=CHANGEME
LAGEBILD_S3_UPLOAD=1
LAGEBILD_S3_PREFIX=s3a://your-bucket/data/user/you/reports/
SITREP_S3_PREFIX=s3a://your-bucket/data/user/you/reports/

TRITON_FORCE_SAMPLE_DATA=0
TRITON_AGENT_MODE=llm
MAPBOX_ACCESS_TOKEN=CHANGEME
AWS_DEFAULT_REGION=us-east-1