# Cloudera Impala (defense schema)
IMPALA_HOST=coordinator-cdw-aw-se-impala.dw-se-sandbox-aws.a465-9q4k.cloudera.site
IMPALA_PORT=443
IMPALA_DATABASE=defense
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_USE_SSL=true
IMPALA_HTTP_PATH=cliservice
# LDAP | PLAIN | NOSASL — AuthMech=12 in JDBC often needs LDAP + corporate credentials
IMPALA_AUTH_MECH=LDAP

# Force sample data even when Impala is reachable
TRITON_FORCE_SAMPLE_DATA=false
# TRITON_DEFAULT_DATA_MODE=auto
# TRITON_FORCE_LIVE_DATA=false

# Lagebild / AIS: auto = Trino if TRINO_* set, else Impala (auto|trino|impala)
LAGEBILD_DATA_ENGINE=auto

# NBA HITL (Trino / Iceberg — same CDW as next-best-action)
# TRINO_JDBC_URL=jdbc:trino://cdw-triton.example:443/iceberg/defense
TRINO_USER=
TRINO_PASSWORD=
TRINO_CATALOG=iceberg
TRINO_SCHEMA=defense

# API server (Vite dev proxies /api here)
API_PORT=3001

# Mapbox basemap (CARTO tiles require their own API key now)
# CML Application: set MAPBOX_ACCESS_TOKEN in Application env — no rebuild needed.
# Local dev build: optional VITE_MAPBOX_TOKEN in .env.local before npm run build
MAPBOX_ACCESS_TOKEN=
# VITE_MAPBOX_TOKEN=

# S3 — prefer project Data Connection "S3 Object Store" on CML (leave keys empty).
# S3_PREFER_CML_CONNECTION=1
# S3_CONNECTION_NAME=S3 Object Store
# Only if using CDP workload access keys (NOT Trino/LDAP password):
# S3_USE_EXPLICIT_KEYS=1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://...
# S3_LIDAR_ALLOWED_PREFIX=s3a://goes-se-sandbox/data/geospatial/transformer/
# LIDAR_USE_CML_S3=auto
# LIDAR_POINTS_LIMIT=12000
# DAS HDF5 preview (optional; same S3 creds / prefix as LiDAR unless overridden):
# S3_DAS_ALLOWED_PREFIX=s3a://goes-se-sandbox/.../das_cable/
# DAS_H5_MAX_MB=48
# DAS_PLAY_MAX_SEC=10

# NATO SITREP PDFs (same prefix as situation-awareness LAGEBILD_S3_PREFIX)
SITREP_S3_PREFIX=s3a://goes-se-sandbox/data/user/you/situation-awareness/reports/
# Optional local dev (same CML project filesystem):
# LAGEBILD_ARTIFACTS_DIR=/home/cdsw/cai-workbench/situation-awareness/artifacts/reports

# Schiffsnähe — SSB MVE real_time_proximity_alert (proxied by GET /api/proximity-alerts)
PROXIMITY_ALERT_API_KEY=a4acf667-33f0-4552-83a8-21f57a7e5eed
PROXIMITY_ALERT_API_URL=https://triton-csa-manager0.cdwh-cdp.djki-j7ns.cloudera.site/triton-csa/cdp-proxy-api/ssb-mve-api/api/v1/query/5196/real_time_proximity_alert
PROXIMITY_ALERT_LIMIT=100
