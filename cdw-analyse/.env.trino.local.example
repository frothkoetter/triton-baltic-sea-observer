# Copy to .env.trino.local and set TRINO_PASSWORD (never commit .env.trino.local)
# Prefer CDW UI: Virtual Warehouse → ⋮ → Copy Trino URL (HTTPS, no jdbc: prefix)
TRINO_SERVER=https://cdw-triton.dw-triton-cdp-env.a465-9q4k.cloudera.site:443
TRINO_JDBC_URL=jdbc:trino://cdw-triton.dw-triton-cdp-env.a465-9q4k.cloudera.site:443/iceberg/defense
TRINO_USER=frothkoetter
TRINO_PASSWORD=
TRINO_CATALOG=iceberg
TRINO_SCHEMA=defense
# JDBC session schema for DDL (after defense exists in DW UI): use defense, not default
TRINO_CONNECT_SCHEMA=defense
TRINO_SKIP_CREATE_SCHEMA=1
# Greenfield: skip DROP TABLE (CDW 404 on DROP); set TRINO_SKIP_DROP=0 when re-applying full DDL
# TRINO_SKIP_DROP=1
# TRINO_FORGIVE_DROP_404=1
# Schema preflight: auto (default) | off | force — CDW often HTTP-404s SHOW SCHEMAS; auto continues DDL.
# TRINO_SCHEMA_PREFLIGHT=auto
# If DDL 404s: create schema ``defense`` on catalog ``iceberg`` in CDW UI, then re-run.
# To let the runner try CREATE SCHEMA: TRINO_SKIP_CREATE_SCHEMA=0 (often 404 on CDW — UI is reliable).
TRINO_QUALIFY_SCHEMA=1
# TRINO_DDL_USE_TARGET_SCHEMA=1