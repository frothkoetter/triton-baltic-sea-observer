# =============================================================================
# Triton Baltic Sea Observer — CML project environment template (.env.default)
# =============================================================================
# Use in Cloudera AI: Project → Settings → Environment Variables (Name / Value).
# Application (triton-nato-ui): inherit project vars + CDSW_APP_POLLING_ENDPOINT.
# Values shown here are non-secret defaults or placeholders — set passwords and
# API keys only in CML (never commit real credentials to git).
#
# Local dev: copy sections to triton-nato-ui/.env.local or cdw-analyse/.env.trino.local
# Autonomous demo: leave TRINO_* empty or TRITON_FORCE_SAMPLE_DATA=true
# =============================================================================

# --- Cloudera ML / Application host ---
PROJECT_OWNER=frothkoetter
CDSW_WORKING_DIRECTORY=/home/cdsw
CDSW_APP_POLLING_ENDPOINT=/healthz
# CDSW_APP_PORT / CDSW_READONLY_PORT — injected by CML; do not set manually

# --- Trino (Iceberg defense) — NBA + NATO UI + cdw-analyse ---
TRINO_JDBC_URL=jdbc:trino://cdw-triton.dw-triton-cdp-env.a465-9q4k.cloudera.site:443/iceberg/defense
TRINO_USER=
TRINO_PASSWORD=
TRINO_CATALOG=iceberg
TRINO_SCHEMA=defense
# Optional split host (trino-bridge also parses TRINO_JDBC_URL):
# TRINO_HOST=cdw-triton.dw-triton-cdp-env.a465-9q4k.cloudera.site
# TRINO_PORT=443
# TRINO_HTTP_SCHEME=https

# --- NBA pipeline (cai-workbench/next-best-action, CML jobs) ---
NBA_PHASE=7
NBA_SIM_TICKS=6
NBA_PERSIST_TRINO=1
NBA_MATERIALIZE=1
NBA_SHACL_GATE=1
NBA_USE_ICEBERG_MCP=0
NBA_SKIP_LLM=1
NBA_EXIT_IF_QUIET=0
NBA_CREWAI_PERSIST=0
NBA_DATA_CLASS=defense
NBA_SNAPSHOT_TABLES=ships,ais_events_ice
NBA_MAT_ROW_LIMIT=25000
# NBA_TRINO_CATALOG=iceberg
# NBA_TRINO_SCHEMA=defense
# NBA_OFFLINE=0
# NBA_DEMO_GREIFSWALD=0
# NBA_DEMO_LAT=54.55
# NBA_DEMO_LON=14.10
# NBA_DEDUPE_HOURS=6
# NBA_ALERT_LIMIT=5
# NBA_ARTIFACTS_DIR=
# NBA_PLAYBOOK_PATH=

# --- NATO UI data mode (Application must inherit TRINO_* from project) ---
# TRITON_FORCE_SAMPLE_DATA=false
# TRITON_DEFAULT_DATA_MODE=auto
# TRITON_FORCE_LIVE_DATA=false

# --- Agent console (replaces SQL tab in NATO UI) ---
# auto | crewai | llm | offline
TRITON_AGENT_MODE=auto
# TRITON_ONTOLOGY_PATH=
# TRITON_REPO_ROOT=   (CML: repo root if not auto-detected)

# --- Mission Planning + SAP D&S (MP-0 / MP-1) ---
# off | sample | odata | trino — sample uses data/sap_readiness_sample.json
NBA_SAP_READINESS_MODE=sample
# SAP_DS_BASE_URL=https://your-tenant.sap.your-landscape
# SAP_DS_CLIENT_ID=
# SAP_DS_CLIENT_SECRET=   (CML secret only)
# NBA_SAP_CAPABILITY_MAP_PATH=
# NBA_SAP_READINESS_SAMPLE_PATH=

# --- Lagebild / situation-awareness (Trino + LLM + S3) ---
LAGEBILD_DATA_ENGINE=trino
LAGEBILD_TRINO_HOST=cdw-triton.dw-triton-cdp-env.a465-9q4k.cloudera.site
LAGEBILD_TRINO_PORT=443
LAGEBILD_TRINO_USER=
LAGEBILD_TRINO_PASSWORD=
LAGEBILD_TRINO_HTTP_SCHEME=https
LAGEBILD_TRINO_CATALOG=iceberg
LAGEBILD_TRINO_SCHEMA=defense
LAGEBILD_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2025-01-01-preview
LAGEBILD_AZURE_API_VERSION=2025-01-01-preview
LAGEBILD_MODEL_ID=
LAGEBILD_API_KEY=
# LAGEBILD_JWT_PATH=/tmp/jwt
# LAGEBILD_MAX_CHAR_LIMIT=32000
# LAGEBILD_USE_SAMPLE=0
# LAGEBILD_SKIP_LLM=0
# LAGEBILD_INSERT_SQL=0
# LAGEBILD_S3_UPLOAD=1

# --- S3 / SITREP / artifacts ---
AWS_DEFAULT_REGION=us-east-1
LAGEBILD_S3_UPLOAD=1
LAGEBILD_S3_PREFIX=s3a://your-bucket/data/user/you/reports/
SITREP_S3_PREFIX=s3a://your-bucket/data/user/you/reports/
# S3_WORKLOAD_USER=
# S3_WORKLOAD_PASSWORD=
# S3_ENDPOINT_URL=
# S3_PREFER_CML_CONNECTION=auto
# S3_CONNECTION_NAME=S3 Object Store
# LAGEBILD_ARTIFACTS_DIR=/home/cdsw/cai-workbench/situation-awareness/artifacts/reports

# --- Triton NATO UI (React + entry.py Application) ---
TRITON_FORCE_SAMPLE_DATA=false
MAPBOX_ACCESS_TOKEN=
# VITE_MAPBOX_TOKEN=
# API_PORT=3001
# NBA_ARTIFACTS_DIR=/home/cdsw/cai-workbench/next-best-action/artifacts/nba

# --- Impala (optional fallback if LAGEBILD_DATA_ENGINE=auto / impala) ---
# IMPALA_HOST=
# IMPALA_PORT=443
# IMPALA_DATABASE=defense
# IMPALA_USER=
# IMPALA_PASSWORD=
# IMPALA_USE_SSL=true
# IMPALA_HTTP_PATH=cliservice
# IMPALA_AUTH_MECH=LDAP

# --- Proximity alerts (Schiffsnähe) ---
# PROXIMITY_ALERT_API_KEY=
# PROXIMITY_ALERT_API_URL=
# PROXIMITY_ALERT_LIMIT=100

# --- LiDAR viewer (optional S3) ---
# S3_LIDAR_ALLOWED_PREFIX=
# LIDAR_USE_CML_S3=auto
# LIDAR_POINTS_LIMIT=12000